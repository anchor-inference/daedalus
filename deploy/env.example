# Copy to .env at the repository root. Never commit .env.

# Telegram is optional. With an empty token the bot runs on its API and its app alone: it prints a
# one-time pairing link at every start (in the log and in <state>/pairing-url), and `docker compose
# exec daedalus python -m daedalus auth pair` mints another. Two-factor sign-in is in Settings → Security.
# With a token, set your own numeric user id too — that account is the only user.
TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=

# Local Bot API server (files up to 2 GB), started with `--profile telegram`. Only needed with a token.
# Get these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Model provider keys do NOT go here: .env lives inside the checkout the agent container mounts.
# Put them in ../daedalus-secrets/keyproxy.env (next to this repository, chmod 600) — see deploy/keyproxy.env.example.
# The key proxy container injects them; the built-in providers point at http://keyproxy:3200/<name>.
#DEEPSEEK_API_KEY=
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=

# Fine-grained GitHub token limited to the two agent repositories (pull requests + contents).
GITHUB_TOKEN=

# Mini App URL (https, served by a reverse proxy in front of port 8765): the host every pairing link
# names, and what a shared dialog's link starts with.
MINIAPP_PUBLIC_URL=

# Who may say what the client's address is, through X-Forwarded-For: the address your reverse proxy
# connects from, as the container sees it (for a proxy on the Docker host, the gateway of the network
# that publishes the API; `docker network inspect` shows it). Empty trusts nobody and every visitor
# counts as the proxy, which is safe but puts them in one bucket of the failed-attempt limits. Never *.
API_TRUSTED_PROXIES=

# A shared service's pages run on an origin of their own, served by this port and nothing else; it is
# published like the services range. See docs/AGENT-SETUP.md.
SERVICES_DOOR_PORT=8766
# The guest door (COMPOSE_PROFILES=guest): what other people's agents reach. GUEST_PUBLIC_URL is the name a
# reverse proxy gives it, never the app's own address. GUEST_DOOR_BIND=0.0.0.0 opens the port on a bare address.
GUEST_DOOR_PORT=8764
# GUEST_PUBLIC_URL=https://agents.example.test
# GUEST_DOOR_BIND=127.0.0.1
# The proxy allowed to name a visitor: an address or network, the "guest" network's gateway. Never a wildcard,
# which the door refuses to start with: any visitor could then name their own address to the limits.
# GUEST_TRUSTED_PROXIES=
# The key proxy's upstreams a stand-in may use. CLI logins never qualify.
# KEYPROXY_GUEST_UPSTREAMS=deepseek,openrouter,openai,anthropic,opencode_zen
# The address of that port, when it has a name: a second host in your reverse proxy, or the same host
# on another port. Empty with an https MINIAPP_PUBLIC_URL means a shared page stays on the app's address
# in a sandbox, where it works without local storage or cookies.
SERVICES_PUBLIC_URL=

# Daily spend cap in USD, enforced by the supervisor (the agent cannot change it).
USD_PER_DAY=20

# The self-hosted SearXNG behind the WebSearch tool signs its own session cookies with this; it is reachable only
# from the agent container, so any random string will do. Only read with `--profile search`: without that
# profile WebSearch goes to DuckDuckGo directly and no SearXNG runs.
SEARXNG_SECRET=

# The user the key proxy runs as. It refreshes the CLI login files mounted into it in place, and those are
# 0600, so this has to be the account that owns them — the operator's, which is 1000 on most single-user hosts.
DAEDALUS_KEYPROXY_UID=1000
DAEDALUS_KEYPROXY_GID=1000


# Absolute paths on the host, used by the rebuilder container (--profile selfdev) to rebuild the image when
# the Dockerfile changes.
DAEDALUS_COMPOSE_PROJECT_DIR=/absolute/path/to/daedalus
DAEDALUS_COMPOSE_FILE=/absolute/path/to/daedalus/deploy/compose.yaml
DAEDALUS_CORE_PROJECT_DIR=/absolute/path/to/protocore-exp

# Ports the agent's own services (ServiceStart) may use; published from the container on every interface.
SERVICES_PORT_RANGE=8100-8119
# The address you reach those ports at from your network (the docker host's LAN address).
SERVICES_PUBLIC_HOST=

# The agent's own GitHub organisation: a token issued with that organisation as resource owner
# (Administration, Contents, Pull requests, Issues, Workflows, Pages: read and write; Metadata: read)
# and the organisation's login. Repositories the agent creates for its work live there; the
# operator's repositories stay on GITHUB_TOKEN and change only through pull requests.
GITHUB_DAEDALUS_TOKEN=
DAEDALUS_GITHUB_ORG=

# Ports a server started in a container terminal may use (a dev server, a preview); published from the
# terminals service on every interface, so they are reached at SERVICES_PUBLIC_HOST:<port> as well.
# Must not overlap SERVICES_PORT_RANGE: one port is published by one container.
TERMINALS_PORT_RANGE=8120-8139

# The host terminal's run directory on the server: where its systemd user unit (installed by
# deploy/setup.sh when you ask for a host terminal) keeps its socket and token. Mounted into the agent
# whether or not the unit is installed. The default is a sibling of this checkout; an absolute path
# here moves it, and setup.sh reads it from this file.
#DAEDALUS_HOST_TERMINALS_DIR=

# The agent's browser: a compose service of its own behind the "browser" profile, running the image's
# `browser` target. Uncomment to start it with the stack (and with every later compose command,
# the rebuilder's included); add other profiles to the same list, comma-separated.
#COMPOSE_PROFILES=browser
# The browser service's memory limit. Two browsers with eight tabs each measured under 1.2 GB.
#BROWSER_MEMORY_LIMIT=3g
# headed (the default: real windows on a virtual display) or headless.
#BROWSER_MODE=headed
# Google Chrome in the browser image (amd64 only; its terms allow installing it, not handing the binary
# on, so it is for an image built here, never a published one), and the browser to run in place of the
# pinned Chromium, by its path in the image. Both together run Google Chrome:
#BROWSER_GOOGLE_CHROME=1
#BROWSER_CHROMIUM=/opt/google/chrome/chrome
# A GPU for the browser's gpu WebGL mode (the agent switches to it only with your yes, or when Settings
# -> Environments -> browser allows it). All three together, then rebuild the browser image and
# recreate the browser service: the render node, the host's group that owns it (stat -c %g
# /dev/dri/renderD128), and the Vulkan drivers in the image. Software WebGL needs none of this.
#BROWSER_GPU_DEVICE=/dev/dri/renderD128
#BROWSER_GPU_GROUP=993
#BROWSER_GPU=1

# What the first-run setup wizard chooses (it writes both; they are safe to edit by hand).
# DAEDALUS_LOCAL_MODEL is a model id served by the endpoint KEYPROXY_UPSTREAM_LOCAL names in keyproxy.env;
# set, it becomes a preset and the default when none is chosen yet. DAEDALUS_VOICE is off, local (the speech
# extra) or cloud (transcription through the openai provider).
DAEDALUS_LOCAL_MODEL=
DAEDALUS_VOICE=
# Encrypted state is opt-in after an operator has migrated and checked the state and backups.
# Set all four values together and always use -f deploy/compose.encrypted-state.yaml after the base file.
# DAEDALUS_ENCRYPTED_STATE_REQUIRED=1
# DAEDALUS_ENCRYPTED_STATE_DIR=/absolute/path/to/mounted-state
# DAEDALUS_ENCRYPTED_STATE_SOURCE=/dev/mapper/daedalus-state
# DAEDALUS_ENCRYPTED_STATE_ID=32-lowercase-hex-digits
