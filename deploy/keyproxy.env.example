# Copy to ../daedalus-secrets/keyproxy.env (OUTSIDE the repository; chmod 600). Only the key proxy reads it, and the
# app writes it from Settings (keys, addresses, headers, the daily cap) without a restart.
# Built-in upstreams: API and subscription keys use separate endpoints and never enter the bot's environment.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
ZAI_CODING_API_KEY=
MINIMAX_API_KEY=
MINIMAX_PLAN_API_KEY=
MOONSHOT_API_KEY=
KIMI_CODING_API_KEY=
# Extra OpenAI-compatible upstreams reachable as http://keyproxy:3200/<name>:
#KEYPROXY_UPSTREAM_MYLLM=https://host/v1
#KEYPROXY_KEY_MYLLM=
# A model server on your own machine (Ollama, llama.cpp, LM Studio): the app reaches it as /local. The key is
# optional; the setup wizard writes these two lines and DAEDALUS_LOCAL_MODEL in the app's .env.
#KEYPROXY_UPSTREAM_LOCAL=http://127.0.0.1:11434/v1
#KEYPROXY_KEY_LOCAL=
# The proxy's own daily cap (USD), read from the agent's database; refuses model calls above it.
KEYPROXY_USD_PER_DAY=20
# Search APIs for the WebSearch tool are built in: only the key is needed, and it can be saved in Settings → Tools →
# Search keys instead of here. Every value in this file can be set from Settings → Models → Providers → Key proxy, and
# the proxy reads the file again on each call, so nothing needs a restart. KEYPROXY_UPSTREAM_<NAME> and
# KEYPROXY_AUTH_<NAME> override a built-in address or key header.
#KEYPROXY_KEY_SERPER=
#KEYPROXY_KEY_KEENABLE=
#KEYPROXY_KEY_TAVILY=
#KEYPROXY_KEY_EXA=
#KEYPROXY_KEY_PERPLEXITY=
