# The host terminal: `ptyd` on the server itself, as the operator, so the app can open a shell here.
# deploy/host-terminal.sh fills in the run directory the agent's container mounts (the --run-dir
# argument below) and installs the result as ~/.config/systemd/user/daedalus-ptyd.service.
# Removing it: systemctl --user disable --now daedalus-ptyd
[Unit]
Description=Daedalus host terminals

[Service]
# The PATH and locale of the shell the installer ran in. A user unit otherwise gets systemd's minimal
# PATH, and a CLI installed under ~/.local/bin would not be found by the programs the daemon runs.
EnvironmentFile=-%h/.config/daedalus/ptyd.env
ExecStart=%h/.local/lib/daedalus/ptyd serve --env host --run-dir "@RUN_DIR@" --state-dir %h/.local/state/daedalus-ptyd
# systemd ignores SIGPIPE in a unit's processes by default, and every program the daemon runs inherits
# that: a pipeline cut short by ``head`` then printed "Broken pipe" into the agent's output and broke the
# base64 file reads. A shell in a terminal has it at the default, so the daemon's programs should too.
IgnoreSIGPIPE=no
# Everything the agent runs on the host runs in this unit's control group, outside any container's
# limit. Eight subagents each building and testing a Rust workspace at once took the machine from
# 15 GB to 61 GB in ten minutes; nothing was killed, the kernel swapped instead, and every service on
# the server stopped answering for an hour until a forced power-off. Above MemoryHigh the group is
# throttled and reclaimed; at MemoryMax the kernel kills the largest process in this group alone.
# Little swap, so a runaway build is killed rather than thrashing the disk for everyone.
MemoryHigh=50%
MemoryMax=60%
MemorySwapMax=2G
# One process killed for memory must not stop the unit: the default would end every terminal with it.
OOMPolicy=continue
Restart=on-failure
RestartSec=2
# KillMode stays control-group: ptyd owns its PTYs, and when it stops they stop.

[Install]
WantedBy=default.target
