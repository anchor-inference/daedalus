{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.1",
  "default_locale": "en",
  "minimum_chrome_version": "125",
  "key": "",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Daedalus", "default_icon": { "16": "icon-16.png", "48": "icon-48.png" } },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "__MSG_open_panel__" }
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "downloads",
    "cookies",
    "nativeMessaging",
    "declarativeNetRequest",
    "storage",
    "scripting",
    "contextMenus",
    "alarms",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"]
}
